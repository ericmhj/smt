# =============================================================================
# SGR - Sistema de Gestión de Reactivos
# Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sgr
POSTGRES_PASSWORD=sgr_dev_password
POSTGRES_DB=sgr_dev
DATABASE_URL=postgresql://sgr:sgr_dev_password@localhost:5432/sgr_dev

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=sgr_redis_dev
REDIS_URL=redis://:sgr_redis_dev@localhost:6379

# -----------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=sgr_minio_dev
MINIO_ROOT_PASSWORD=sgr_minio_dev_password
MINIO_BUCKET=sgr-files
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# ClamAV (Antivirus scanning)
# -----------------------------------------------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Authentication Mode
# -----------------------------------------------------------------------------
# Set to "true" for standalone mode (local DB credential validation).
# Set to "false" for integrated mode (Keycloak cascade validation).
STANDALONE_AUTH=true

# -----------------------------------------------------------------------------
# Keycloak (required when STANDALONE_AUTH=false)
# -----------------------------------------------------------------------------
# Token endpoint for Direct Access Grant (Resource Owner Password Credentials)
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/mikel-crm/protocol/openid-connect/token
# OAuth2 client credentials
KEYCLOAK_CLIENT_ID=sgr-client
KEYCLOAK_CLIENT_SECRET=your-secret-here
# JWKS endpoint for token verification
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/mikel-crm/protocol/openid-connect/certs
# Token issuer (must match the "iss" claim in Keycloak-issued JWTs)
KEYCLOAK_ISSUER=http://keycloak:8080/realms/mikel-crm

# -----------------------------------------------------------------------------
# Keycloak Admin (user provisioning, required when STANDALONE_AUTH=false)
# -----------------------------------------------------------------------------
# Base URL of the Keycloak server (without /auth suffix)
KEYCLOAK_ADMIN_URL=http://keycloak:8080
# Realm where the admin user lives (usually 'master')
KEYCLOAK_ADMIN_REALM=master
# Admin credentials for the master realm
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=your-admin-password-here
# Target realm where tenant users are created
KEYCLOAK_TARGET_REALM=mikel-crm

# -----------------------------------------------------------------------------
# License Service (required when STANDALONE_AUTH=false)
# -----------------------------------------------------------------------------
LICENSE_SERVICE_URL=http://license-service:3002

# -----------------------------------------------------------------------------
# JWT Authentication (RS256)
# -----------------------------------------------------------------------------
# Generate keys with: openssl genrsa -out private.pem 2048
#                     openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=sgr-api

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_FORMATS=jpg,png,pdf,doc,docx,xls,xlsx

# -----------------------------------------------------------------------------
# Email / SMTP (for notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sgr.local
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=pretty
