{
  "name": "@sgr/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "echo 'Using tsx runtime - no build needed'",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@sgr/shared": "workspace:*",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "drizzle-orm": "^0.35.0",
    "postgres": "^3.4.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.4.0",
    "bcrypt": "^5.1.0",
    "jose": "^5.9.0",
    "zod": "^3.23.0",
    "pdfkit": "^0.15.0",
    "puppeteer": "^23.0.0",
    "dompurify": "^3.1.0",
    "jsdom": "^25.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "@types/node": "^20.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/dompurify": "^3.0.0",
    "@types/jsdom": "^21.0.0",
    "typescript": "^5.6.0",
    "drizzle-kit": "^0.25.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0"
  }
}
